<!-- Dialog window: white panel with a solid black border instead of an
     elevation shadow (shadows are almost invisible on e-ink). Insets match
     AppCompat's abc_dialog_material_background. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="16dp"
    android:insetLeft="16dp"
    android:insetRight="16dp"
    android:insetTop="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/eink_paper" />
        <stroke
            android:width="2dp"
            android:color="@color/eink_ink" />
        <corners android:radius="2dp" />
    </shape>
</inset>
