<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme: high-contrast light theme for e-ink displays.
         Pure black ink on pure white paper, no animations, no elevation shadows. -->
    <style name="Theme.Fabularium" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/eink_paper</item>
        <item name="colorPrimaryDark">@color/eink_paper</item>
        <item name="colorAccent">@color/eink_ink</item>
        <item name="colorControlNormal">@color/eink_ink</item>
        <item name="colorControlActivated">@color/eink_ink</item>
        <item name="colorControlHighlight">@color/eink_pressed</item>
        <item name="colorButtonNormal">@color/eink_paper</item>
        <item name="android:colorBackground">@color/eink_paper</item>
        <item name="android:windowBackground">@color/eink_paper</item>
        <item name="android:textColorPrimary">@color/eink_ink</item>
        <item name="android:textColorSecondary">@color/eink_ink_secondary</item>
        <item name="android:textColorTertiary">@color/eink_ink_secondary</item>
        <item name="android:textColorHint">@color/eink_ink_secondary</item>
        <item name="android:textColor">@color/eink_ink</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/eink_paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/eink_paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <!-- Animations cause ghosting and slow partial refreshes on e-ink. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="alertDialogTheme">@style/Theme.Fabularium.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Fabularium.Dialog</item>
        <item name="tabStyle">@style/Widget.Fabularium.TabLayout</item>
        <item name="android:listDivider">@drawable/list_divider</item>
        <item name="popupMenuStyle">@style/Widget.Fabularium.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Fabularium.PopupMenu.Overflow</item>
        <item name="listPopupWindowStyle">@style/Widget.Fabularium.ListPopupWindow</item>
        <item name="android:popupMenuStyle">@style/Widget.Fabularium.PopupMenu</item>
        <item name="android:listPopupWindowStyle">@style/Widget.Fabularium.ListPopupWindow</item>
    </style>

    <style name="Theme.Fabularium.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/eink_ink</item>
        <item name="colorControlNormal">@color/eink_ink</item>
        <item name="colorControlActivated">@color/eink_ink</item>
        <item name="colorControlHighlight">@color/eink_pressed</item>
        <item name="android:textColorPrimary">@color/eink_ink</item>
        <item name="android:textColorSecondary">@color/eink_ink_secondary</item>
        <item name="android:textColor">@color/eink_ink</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Border instead of shadow; no grey dim behind the dialog. -->
        <item name="android:windowBackground">@drawable/eink_dialog_background</item>
        <item name="android:windowElevation" tools:targetApi="lollipop">0dp</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Widget.Fabularium.PopupMenu" parent="Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/eink_popup_background</item>
        <item name="android:popupElevation" tools:targetApi="lollipop">0dp</item>
    </style>

    <style name="Widget.Fabularium.PopupMenu.Overflow" parent="Widget.AppCompat.Light.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/eink_popup_background</item>
        <item name="android:popupElevation" tools:targetApi="lollipop">0dp</item>
    </style>

    <style name="Widget.Fabularium.ListPopupWindow" parent="Widget.AppCompat.Light.ListPopupWindow">
        <item name="android:popupBackground">@drawable/eink_popup_background</item>
        <item name="android:popupElevation" tools:targetApi="lollipop">0dp</item>
    </style>

    <!-- Toolbar overlay: dark ink on the white toolbar. -->
    <style name="ThemeOverlay.Fabularium.Toolbar" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/eink_ink</item>
        <item name="android:textColorSecondary">@color/eink_ink</item>
        <item name="colorControlNormal">@color/eink_ink</item>
        <item name="colorControlHighlight">@color/eink_pressed</item>
    </style>

    <style name="Widget.Fabularium.TabLayout" parent="Widget.Design.TabLayout">
        <item name="tabTextColor">@color/eink_ink_secondary</item>
        <item name="tabSelectedTextColor">@color/eink_ink</item>
        <item name="tabIndicatorColor">@color/eink_ink</item>
        <item name="tabIndicatorHeight">4dp</item>
        <item name="tabRippleColor">@null</item>
    </style>

    <style name="Theme.Fabularium.Translucent" parent="Theme.Fabularium">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="scrollingStyle">@style/scrolling</item>
    </style>

    <style name="scrolling">
        <item name="android:scrollbarStyle">outsideOverlay</item>
        <item name="android:scrollbars">horizontal|vertical</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/scrollbar_horizontal_thumb</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_vertical_thumb</item>
    </style>

    <declare-styleable name="GLKKeyboardView">
        <!-- Default KeyboardView style. -->
        <attr name="keyboardViewStyle" format="reference" />

        <!-- Image for the key. This image needs to be a StateListDrawable, with the following
             possible states: normal, pressed, checkable, checkable+pressed, checkable+checked,
             checkable+checked+pressed. -->
        <attr name="keyBackground" format="reference" />

        <!-- Size of the text for character keys. -->
        <attr name="keyTextSize" format="dimension" />

        <!-- Size of the text for custom keys with some text and no icon. -->
        <attr name="labelTextSize" format="dimension" />

        <!-- Color to use for the label in a key. -->
        <attr name="keyTextColor" format="color" />

        <!-- Layout resource for key press feedback.-->
        <attr name="keyPreviewLayout" format="reference" />

        <!-- Vertical offset of the key press feedback from the key. -->
        <attr name="keyPreviewOffset" format="dimension" />

        <!-- Height of the key press feedback popup. -->
        <attr name="keyPreviewHeight" format="dimension" />

        <!-- Amount to offset the touch Y coordinate by, for bias correction. -->
        <attr name="verticalCorrection" format="dimension" />

        <!-- Layout resource for popup keyboards. -->
        <attr name="popupLayout" format="reference" />

        <attr name="shadowColor" />
        <attr name="shadowRadius" />
    </declare-styleable>

    <declare-styleable name="GLKKeyboardViewPreviewState">
        <!-- State for {@link android.inputmethodservice.KeyboardView KeyboardView}
                key preview background. -->
        <attr name="state_long_pressable" format="boolean" />
    </declare-styleable>

    <declare-styleable name="GLKKeyboard">
        <!-- Default width of a key, in pixels or percentage of display width. -->
        <attr name="keyWidth" format="dimension|fraction" />
        <!-- Default height of a key, in pixels or percentage of display width. -->
        <attr name="keyHeight" format="dimension|fraction" />
        <!-- Default horizontal gap between keys. -->
        <attr name="horizontalGap" format="dimension|fraction" />
        <!-- Default vertical gap between rows of keys. -->
        <attr name="verticalGap" format="dimension|fraction" />
    </declare-styleable>

    <declare-styleable name="GLKKeyboard_Row">
        <!-- Row edge flags. -->
        <attr name="rowEdgeFlags">
            <!-- Row is anchored to the top of the keyboard. -->
            <flag name="top" value="4" />
            <!-- Row is anchored to the bottom of the keyboard. -->
            <flag name="bottom" value="8" />
        </attr>
        <!-- Mode of the keyboard. If the mode doesn't match the
             requested keyboard mode, the row will be skipped. -->
        <attr name="keyboardMode" format="reference" />
    </declare-styleable>

    <declare-styleable name="GLKKeyboard_Key">
        <!-- The unicode value or comma-separated values that this key outputs. -->
        <attr name="codes" format="integer|string" />
        <!-- The XML keyboard layout of any popup keyboard. -->
        <attr name="popupKeyboard" format="reference" />
        <!-- The characters to display in the popup keyboard. -->
        <attr name="popupCharacters" format="string" />
        <!-- Key edge flags. -->
        <attr name="keyEdgeFlags">
            <!-- Key is anchored to the left of the keyboard. -->
            <flag name="left" value="1" />
            <!-- Key is anchored to the right of the keyboard. -->
            <flag name="right" value="2" />
        </attr>
        <!-- Whether this is a modifier key such as Alt or Shift. -->
        <attr name="isModifier" format="boolean" />
        <!-- Whether this is a toggle key. -->
        <attr name="isSticky" format="boolean" />
        <!-- Whether long-pressing on this key will make it repeat. -->
        <attr name="isRepeatable" format="boolean" />
        <!-- The icon to show in the popup preview. -->
        <attr name="iconPreview" format="reference" />
        <!-- The string of characters to output when this key is pressed. -->
        <attr name="keyOutputText" format="string" />
        <!-- The label to display on the key. -->
        <attr name="keyLabel" format="string" />
        <!-- The icon to display on the key instead of the label. -->
        <attr name="keyIcon" format="reference" />
        <!-- Mode of the keyboard. If the mode doesn't match the
             requested keyboard mode, the key will be skipped. -->
        <attr name="keyboardMode" />
    </declare-styleable>

    <dimen name="alert_def_padding">18dp</dimen>

</resources>